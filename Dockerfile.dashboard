FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN groupadd --gid 1000 dashboard \
    && useradd --uid 1000 --gid 1000 --create-home dashboard \
    && mkdir -p /app /data \
    && chown -R dashboard:dashboard /app /data

WORKDIR /app
COPY --chown=dashboard:dashboard app /app/app
COPY --chown=dashboard:dashboard config.example.json /app/config.example.json
COPY --chown=dashboard:dashboard deploy/dashboard-entrypoint.sh /app/dashboard-entrypoint.sh
RUN chmod 0555 /app/dashboard-entrypoint.sh

USER dashboard:dashboard
EXPOSE 8080
VOLUME ["/data"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["python", "-c", "import json,urllib.request; assert json.load(urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3))['status']=='ok'"]

ENTRYPOINT ["/app/dashboard-entrypoint.sh"]
